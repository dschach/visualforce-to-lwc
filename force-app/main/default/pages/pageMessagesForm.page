<apex:page controller="PageMessagesFormController">
	<apex:form>
		<apex:pageMessages />
		<apex:pageBlock title="Error Handling" mode="edit">
			<apex:pageBlockSection>
				<apex:inputText value="{!cityName}" label="Enter City Name: " />
			</apex:pageBlockSection>
			<apex:pageBlockButtons>
				<apex:commandButton value="Cancel" action="{!cancel}" />
				<apex:commandButton value="Save" action="{!createCity}" />
			</apex:pageBlockButtons>
		</apex:pageBlock>
	</apex:form>
</apex:page>
